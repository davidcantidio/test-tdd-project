name: 🚀 CI/CD Pipeline
# Unified CI/CD workflow for TDD Framework with História 2.2 AI Configuration System
# Consolidates testing, automation, and deployment into a single efficient workflow

on:
  push:
    branches: [ main, develop ]
    # Comprehensive path coverage for all project components
    paths:
      # Core application code
      - 'streamlit_extension/**/*.py'
      - 'duration_system/**/*.py'
      - 'src/**/*.py'
      
      # Tests (all categories)
      - 'tests/**/*.py'
      
      # Configuration and data
      - 'configs/**'
      - 'prompts/**'
      - 'epics/*.json'
      - 'epic_*.json'
      
      # Scripts and automation
      - 'scripts/**/*.py'
      
      # Documentation that affects functionality
      - '*.md'
      - 'docs/**'
      
      # Workflow files
      - '.github/workflows/ci.yml'

  pull_request:
    branches: [ main ]
    types: [opened, synchronize, ready_for_review]

  # GitHub events integration
  issues:
    types: [opened, closed, labeled]
  milestone:
    types: [closed, opened]

  # Manual trigger with options
  workflow_dispatch:
    inputs:
      test_scope:
        description: 'Test scope to run'
        required: false
        default: 'all'
        type: choice
        options:
        - all
        - unit
        - integration
        - security
      deploy_docs:
        description: 'Deploy documentation'
        required: false
        default: true
        type: boolean

env:
  PYTHON_VERSION: '3.11'
  CACHE_VERSION: v1

permissions:
  contents: write
  pages: write
  id-token: write
  issues: read
  pull-requests: write

# Cancel concurrent runs
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # Job 1: Fast validation and setup
  validate:
    name: 🔍 Quick Validation
    runs-on: ubuntu-latest
    timeout-minutes: 5
    
    outputs:
      has-python-changes: ${{ steps.changes.outputs.python }}
      has-test-changes: ${{ steps.changes.outputs.tests }}
      has-config-changes: ${{ steps.changes.outputs.config }}
      should-test: ${{ steps.decide.outputs.should-test }}
      should-deploy: ${{ steps.decide.outputs.should-deploy }}
    
    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: 🔍 Detect Changes
        uses: dorny/paths-filter@v2
        id: changes
        with:
          filters: |
            python:
              - 'streamlit_extension/**/*.py'
              - 'duration_system/**/*.py'
              - 'src/**/*.py'
            tests:
              - 'tests/**/*.py'
            config:
              - 'configs/**'
              - 'prompts/**'
              - '*.yml'
            docs:
              - '*.md'
              - 'docs/**'

      - name: 🎯 Decide Actions
        id: decide
        run: |
          # Decide what to run based on changes
          if [[ "${{ steps.changes.outputs.python }}" == "true" || "${{ steps.changes.outputs.tests }}" == "true" || "${{ github.event_name }}" == "workflow_dispatch" ]]; then
            echo "should-test=true" >> $GITHUB_OUTPUT
          else
            echo "should-test=false" >> $GITHUB_OUTPUT
          fi
          
          if [[ "${{ steps.changes.outputs.docs }}" == "true" || "${{ github.event_name }}" == "workflow_dispatch" ]]; then
            echo "should-deploy=true" >> $GITHUB_OUTPUT
          else
            echo "should-deploy=false" >> $GITHUB_OUTPUT
          fi

      - name: 📊 Validation Summary
        run: |
          echo "## 🔍 CI/CD Pipeline Summary" >> $GITHUB_STEP_SUMMARY
          echo "- Python changes: ${{ steps.changes.outputs.python }}" >> $GITHUB_STEP_SUMMARY
          echo "- Test changes: ${{ steps.changes.outputs.tests }}" >> $GITHUB_STEP_SUMMARY
          echo "- Config changes: ${{ steps.changes.outputs.config }}" >> $GITHUB_STEP_SUMMARY
          echo "- Should test: ${{ steps.decide.outputs.should-test }}" >> $GITHUB_STEP_SUMMARY
          echo "- Should deploy: ${{ steps.decide.outputs.should-deploy }}" >> $GITHUB_STEP_SUMMARY

  # Job 2: Comprehensive testing
  test:
    name: 🧪 Test Suite
    runs-on: ubuntu-latest
    needs: validate
    if: needs.validate.outputs.should-test == 'true'
    timeout-minutes: 15
    
    strategy:
      fail-fast: false
      matrix:
        test-suite: [
          { name: "unit", cmd: "pytest tests/ --ignore=tests/integration --ignore=tests/performance -x" },
          { name: "integration", cmd: "pytest tests/integration/ -v" },
          { name: "security", cmd: "pytest tests/ -k security -v" },
          { name: "história-2.2", cmd: "pytest tests/epics/ -v" }
        ]
    
    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4

      - name: 🐍 Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          cache: 'pip'
          cache-dependency-path: |
            requirements.txt
            **/requirements*.txt

      - name: 📦 Install Dependencies
        run: |
          pip install --upgrade pip
          # Install test dependencies
          pip install pytest pytest-cov pytest-xdist pytest-timeout
          # Install core dependencies
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          # Install optional dependencies for comprehensive testing
          pip install streamlit plotly pandas typer rich || echo "⚠️ Optional dependencies not available"

      - name: 🧪 Run ${{ matrix.test-suite.name }} Tests
        run: |
          echo "🔄 Running ${{ matrix.test-suite.name }} test suite..."
          ${{ matrix.test-suite.cmd }}

      - name: 📊 Test Report
        if: always()
        run: |
          echo "## 🧪 ${{ matrix.test-suite.name }} Test Results" >> $GITHUB_STEP_SUMMARY
          if [ $? -eq 0 ]; then
            echo "✅ All tests passed" >> $GITHUB_STEP_SUMMARY
          else
            echo "❌ Some tests failed" >> $GITHUB_STEP_SUMMARY
          fi

  # Job 3: TDD automation and diagrams
  automation:
    name: 🎯 TDD Automation
    runs-on: ubuntu-latest
    needs: [validate, test]
    if: always() && (needs.validate.outputs.has-config-changes == 'true' || github.event_name == 'issues' || github.event_name == 'milestone')
    timeout-minutes: 10
    
    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: 🐍 Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          cache: 'pip'

      - name: 📦 Install Dependencies
        run: |
          pip install --upgrade pip
          pip install json5

      - name: 🔍 Validate Epic Files
        run: |
          epic_count=$(find . -name "epic*.json" -type f 2>/dev/null | wc -l)
          if [ $epic_count -eq 0 ]; then
            echo "⚠️ No epic files found, skipping diagram generation"
            echo "SKIP_DIAGRAMS=true" >> $GITHUB_ENV
          else
            echo "✅ Found $epic_count epic files"
            echo "SKIP_DIAGRAMS=false" >> $GITHUB_ENV
          fi

      - name: 📊 Generate TDD Diagrams
        if: env.SKIP_DIAGRAMS == 'false'
        run: |
          if [ -f "scripts/analysis/generate_all_diagrams.py" ]; then
            python scripts/analysis/generate_all_diagrams.py
            echo "✅ TDD diagrams generated"
          else
            echo "⚠️ Diagram generation script not found"
          fi

      - name: 📈 Update Progress Tracking
        if: github.event_name == 'issues' || github.event_name == 'milestone'
        run: |
          if [ -f "tests/scripts/gantt_tracker.py" ]; then
            python tests/scripts/gantt_tracker.py
            echo "✅ Progress tracking updated"
          fi

      - name: 💾 Commit Updates
        if: env.SKIP_DIAGRAMS == 'false'
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"
          
          if ! git diff --quiet; then
            git add docs/ || true
            git commit -m "🤖 Auto-update TDD diagrams and progress tracking

            📊 Generated from CI/CD pipeline
            🔄 Triggered by: ${{ github.event_name }}
            
            Co-Authored-By: GitHub Actions <action@github.com>" || echo "No changes to commit"
            git push
          else
            echo "No diagram changes to commit"
          fi

  # Job 4: Documentation deployment  
  deploy-docs:
    name: 📚 Deploy Documentation
    runs-on: ubuntu-latest
    needs: [validate, test]
    if: always() && needs.validate.outputs.should-deploy == 'true' && github.ref == 'refs/heads/main'
    timeout-minutes: 10
    
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    
    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4

      - name: 💎 Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: '3.1'
          bundler-cache: true
          working-directory: ./docs

      - name: 🔧 Setup Pages
        id: pages
        uses: actions/configure-pages@v5

      - name: 🏗️ Build with Jekyll
        run: |
          cd docs
          bundle exec jekyll build --baseurl "${{ steps.pages.outputs.base_path }}"
        env:
          JEKYLL_ENV: production

      - name: 📤 Upload Pages Artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./docs/_site

      - name: 🚀 Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4

  # Job 5: Summary and notifications
  summary:
    name: 📋 Pipeline Summary
    runs-on: ubuntu-latest
    needs: [validate, test, automation, deploy-docs]
    if: always()
    
    steps:
      - name: 📊 Generate Summary
        run: |
          echo "# 🚀 CI/CD Pipeline Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "## Job Results" >> $GITHUB_STEP_SUMMARY
          echo "- 🔍 Validation: ${{ needs.validate.result }}" >> $GITHUB_STEP_SUMMARY
          echo "- 🧪 Tests: ${{ needs.test.result }}" >> $GITHUB_STEP_SUMMARY
          echo "- 🎯 Automation: ${{ needs.automation.result }}" >> $GITHUB_STEP_SUMMARY
          echo "- 📚 Documentation: ${{ needs.deploy-docs.result }}" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          
          # Overall status
          if [[ "${{ needs.test.result }}" == "success" || "${{ needs.test.result }}" == "skipped" ]]; then
            echo "## ✅ Pipeline Status: SUCCESS" >> $GITHUB_STEP_SUMMARY
            echo "All critical jobs completed successfully!" >> $GITHUB_STEP_SUMMARY
          else
            echo "## ❌ Pipeline Status: FAILED" >> $GITHUB_STEP_SUMMARY  
            echo "Some critical jobs failed. Please review the logs." >> $GITHUB_STEP_SUMMARY
          fi
          
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "## 📊 Coverage" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ História 2.2 AI Configuration System" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ Core application components" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ Security and integration tests" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ Documentation deployment" >> $GITHUB_STEP_SUMMARY

      - name: 💬 PR Comment
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const summary = `## 🚀 CI/CD Pipeline Results
            
            - 🔍 **Validation**: ${{ needs.validate.result }}
            - 🧪 **Tests**: ${{ needs.test.result }}  
            - 🎯 **Automation**: ${{ needs.automation.result }}
            - 📚 **Documentation**: ${{ needs.deploy-docs.result }}
            
            ${needs.test.result === 'success' ? '✅ All tests passed!' : '❌ Some tests failed - please review'}
            
            História 2.2 AI Configuration System coverage included.`;
            
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: summary
            });